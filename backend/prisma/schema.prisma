generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String     @id @default(uuid())
  email    String     @unique @db.VarChar(250)
  password String     @db.VarChar(250)
  status   UserStatus @default(ACTIVE)
  roleId   String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  role          Role             @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  profile       UserProfile?
  refreshTokens RefreshToken[]
  boardLists    BoardList[]
  createdTasks  Task[]           @relation("TaskCreator")
  assignedTasks Task[]           @relation("TaskAssignee")
  managedTasks  Task[]           @relation("TaskAssignedBy")
  attachments   TaskAttachment[] @relation("AttachmentUploader")
  taskStatusActivities TaskStatusActivity[] @relation("TaskStatusActor")

  @@index([deletedAt])
  @@map("users")
}

model UserProfile {
  id String @id @default(uuid())

  userId        String @unique
  fullName      String @db.VarChar(500)
  phoneNumber   String? @db.VarChar(20)
  jobTitle      String? @db.VarChar(250)
  department    String? @db.VarChar(250)
  bio           String? @db.Text
  location      String? @db.VarChar(250)
  dateOfBirth   DateTime?
  avatarUrl     String? @db.VarChar(1000)
  avatarPublicId String? @db.VarChar(255)
  avatarMimeType String? @db.VarChar(100)
  avatarSize    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("user_profiles")
}

model RefreshToken {
  id     String @id @default(uuid())
  token  String @unique @db.VarChar(1000)
  userId String

  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Role {
  id          String   @id @default(uuid())
  code        RoleCode @unique
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  isActive    Boolean  @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  permissions Permission[]
  users       User[]

  @@index([deletedAt])
  @@map("roles")
}

model Permission {
  id          String     @id @default(uuid())
  code        String     @unique @db.VarChar(150)
  name        String     @db.VarChar(500)
  description String?    @db.Text
  path        String     @db.VarChar(1000)
  method      HttpMethod
  module      String     @default("") @db.VarChar(500)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  roles Role[]

  @@index([deletedAt])
  @@map("permissions")
}

model BoardList {
  id          String   @id @default(uuid())
  ownerId     String
  name        String   @db.VarChar(120)
  slug        String   @db.VarChar(120)
  description String?  @db.Text
  color       String?  @db.VarChar(50)
  position    Int      @default(0)
  kind        ListKind @default(CUSTOM)
  isFixed     Boolean  @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  owner User   @relation(fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tasks Task[]

  @@unique([ownerId, slug])
  @@index([ownerId, deletedAt])
  @@map("board_lists")
}

model Task {
  id          String       @id @default(uuid())
  title       String       @db.VarChar(250)
  description String?      @db.Text
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  position    Int          @default(0)
  source      TaskSource   @default(SELF_CREATED)

  listId              String
  creatorId           String
  assigneeId          String
  assignedById        String?
  isLockedForAssignee Boolean @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  completedAt DateTime?
  assigneeDismissedAt DateTime?

  list       BoardList         @relation(fields: [listId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  creator    User              @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  assignee   User              @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  assignedBy User?             @relation("TaskAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  attachments TaskAttachment[]
  statusActivities TaskStatusActivity[]

  @@index([assigneeId, deletedAt])
  @@index([assignedById, source, deletedAt])
  @@index([listId, position])
  @@map("tasks")
}

model TaskStatusActivity {
  id         String      @id @default(uuid())
  taskId      String
  actorId     String
  fromStatus  TaskStatus?
  toStatus    TaskStatus
  createdAt   DateTime    @default(now())

  task  Task @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  actor User @relation("TaskStatusActor", fields: [actorId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([taskId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("task_status_activities")
}

model TaskAttachment {
  id           String         @id @default(uuid())
  taskId        String
  uploaderId    String
  kind          AttachmentKind
  url           String         @db.VarChar(1000)
  publicId      String         @unique @db.VarChar(255)
  resourceType  String         @db.VarChar(50)
  originalName  String         @db.VarChar(255)
  mimeType      String         @db.VarChar(100)
  bytes         Int
  width         Int?
  height        Int?
  createdAt     DateTime       @default(now())

  task     Task @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  uploader User @relation("AttachmentUploader", fields: [uploaderId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([taskId])
  @@map("task_attachments")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum RoleCode {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum HttpMethod {
  GET
  POST
  PUT
  DELETE
  PATCH
  OPTIONS
  HEAD
}

enum ListKind {
  CUSTOM
  SYSTEM_ASSIGNED
}

enum TaskSource {
  SELF_CREATED
  MANAGER_ASSIGNED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AttachmentKind {
  IMAGE
  FILE
}
